# Application Settings
PROJECT_NAME="Dynamic AI Chatbot"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5500"

# Caching & Session Storage (Falls back to in-memory cache if Redis is offline)
REDIS_URL="redis://localhost:6379/0"

# Relational Database (Uses local SQLite by default, switch to PostgreSQL for production)
DATABASE_URL="sqlite:///./chatbot.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://chatbot_user:secure_password@localhost:5432/chatbot"

# Generative LLM Provider ("openrouter", "groq", "mock")
LLM_PROVIDER="openrouter"
DEFAULT_LLM_MODEL="minimax/minimax-m3.1-flash:free"
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Multi-Platform Adapter Secrets (Optional)
TELEGRAM_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# Analytics Security
ANALYTICS_API_KEY="dev_analytics_secret_key"
